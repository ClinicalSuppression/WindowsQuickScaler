<Window x:Class="WindowsQuickScaler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Quick Scaler" Height="560" Width="900" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4"
        Closing="Window_Closing">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Presets & Settings -->
        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Scaling Presets" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="Choose the scale and selected monitor cards, then save a preset."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ListBox x:Name="PresetsListBox" Height="190" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Apply Selected" Width="105" Click="BtnApply_Click" Background="#007ACC" Foreground="White" Margin="0,0,5,0"/>
                <Button Content="Save Preset" Width="95" Click="BtnAddPreset_Click" Margin="0,0,5,0"/>
                <Button Content="Delete" Width="80" Click="BtnDeletePreset_Click"/>
            </StackPanel>

            <Separator Margin="0,5,0,15"/>

            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close (Default: On)" IsChecked="True" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkStartup" Content="Run app automatically with Windows" Checked="ChkStartup_Changed" Unchecked="ChkStartup_Changed"/>
        </StackPanel>

        <!-- Right Panel: Interactive Display Layout Canvas -->
        <Border Grid.Column="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Display Layout &amp; Selection" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Click individual monitor cards to toggle target selection:" FontSize="11" Foreground="Gray" Grid.Row="0" Margin="0,22,0,0"/>

                <!-- Dynamic Visual Monitor Canvas Map -->
                <Canvas x:Name="MonitorCanvas" Grid.Row="1" Background="#FAFAFA" Margin="0,10,0,10" ClipToBounds="True"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Target Scale:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbScaleTarget" Width="90" SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="100%"/>
                        <ComboBoxItem Content="125%"/>
                        <ComboBoxItem Content="150%"/>
                        <ComboBoxItem Content="175%"/>
                        <ComboBoxItem Content="200%"/>
                    </ComboBox>
                    <Button Content="Select All" Click="BtnSelectAll_Click" Padding="10,4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>